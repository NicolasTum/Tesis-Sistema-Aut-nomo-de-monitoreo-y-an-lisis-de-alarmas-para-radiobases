void smtpCallback(SMTP_Status status) {
  Serial.println(status.info());
  if (status.success()) {
    Serial.println("----------------");
    Serial.printf("Message sent success: %d\n", status.completedCount());
    Serial.printf("Message sent failed: %d\n", status.failedCount());
    Serial.println("----------------\n");
    smtp.sendingResult.clear();
  }
}

// Verificación de Salida a Internet.
bool hasInternet_() {
  if (WiFi.status() != WL_CONNECTED) return false;

  WiFiClient client;
  client.setTimeout(1500);

  bool ok = client.connect(IPAddress(8, 8, 8, 8), 53);

  client.stop();
  return ok;
}



// ===== [MAIL] URL encode simple =====
static bool isUnreserved(char c) {
  if (c >= 'A' && c <= 'Z') return true;
  if (c >= 'a' && c <= 'z') return true;
  if (c >= '0' && c <= '9') return true;
  switch (c) {
    case '-': case '_': case '.': case '~': return true;
    default: return false;
  }
}
static String urlEncode(const String& s) {
  const char* hex = "0123456789ABCDEF";
  String out;
  out.reserve(s.length() * 3);
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (isUnreserved(c)) {
      out += c;
    } else {
      out += '%';
      out += hex[(c >> 4) & 0x0F];
      out += hex[c & 0x0F];
    }
  }
  return out;
}

// ===== [MAIL] Setear lista de destinatarios =====
static void setRecipientsFromArray(JsonArray arr) {
  gRecipientCount = 0;

  for (JsonVariant v : arr) {
    if (!v.is<const char*>()) continue;
    String email = String((const char*)v);
    email.trim();
    if (email.length() == 0) continue;

    bool exists = false;
    for (int i = 0; i < gRecipientCount; i++) {
      if (gRecipients[i].equalsIgnoreCase(email)) { exists = true; break; }
    }
    if (exists) continue;

    if (gRecipientCount < MAX_RECIPIENTS) {
      gRecipients[gRecipientCount++] = email;
    }
  }

  Serial.print("📧 Routing recipients cargados: ");
  Serial.println(gRecipientCount);
  for (int i = 0; i < gRecipientCount; i++) {
    Serial.print("   - ");
    Serial.println(gRecipients[i]);
  }
}

// ===== [MAIL] Fetch del routing desde Apps Script =====
static bool fetchRoutingRecipients(bool force = false) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("⚠ Routing: sin WiFi (no se puede fetchear). Se usará fallback si hace falta.");
    return false;
  }

  uint32_t now = millis();
  if (!force && (now - lastRoutingFetchMs) < ROUTING_REFRESH_MS && lastRoutingFetchMs != 0) {
    Serial.println("ℹ️ Routing: usando cache (no se refetchea).");
    return (gRecipientCount > 0);
  }
  lastRoutingFetchMs = now;

  String url = String(ROUTING_ENDPOINT) + "?device_id=" + urlEncode(String(DEVICE_ID));
  Serial.print("🌐 Routing GET: ");
  Serial.println(url);

  WiFiClientSecure client;
  client.setInsecure(); // para evitar problemas de certificados en ESP32

  HTTPClient http;
  http.setTimeout(4000);

  // ===== [MOD - MAIL] IMPORTANTE: seguir redirects (Apps Script suele responder 302) =====
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);

  if (!http.begin(client, url)) {
    Serial.println("❌ Routing: http.begin falló");
    http.end();
    return false;
  }

  int code = http.GET();
  if (code <= 0) {
    Serial.print("❌ Routing: HTTP GET error: ");
    Serial.println(code);
    http.end();
    return false;
  }

  String payload = http.getString();
  http.end();

  Serial.print("🌐 Routing HTTP code: ");
  Serial.println(code);

  // ===== [MOD - MAIL] Solo procesar JSON si es 200 =====
  if (code != 200) {
    Serial.print("❌ Routing: HTTP != 200. Payload head: ");
    Serial.println(payload.substring(0, 200));
    return false;
  }

  // ===== [MOD - MAIL] Debug compacto (no imprimir todo el HTML/JSON) =====
  Serial.print("🌐 Routing payload head: ");
  Serial.println(payload.substring(0, 200));

  DynamicJsonDocument doc(1024);
  DeserializationError err = deserializeJson(doc, payload);
  if (err) {
    Serial.print("❌ JSON parse routing error: ");
    Serial.println(err.c_str());
    Serial.print("   Payload head (debug): ");
    Serial.println(payload.substring(0, 200));
    return false;
  }

  bool ok = doc["ok"] | false;
  if (!ok) {
    Serial.print("❌ routing ok=false. error=");
    Serial.println((const char*)(doc["error"] | "unknown"));
    return false;
  }

  if (!doc["emails"].is<JsonArray>()) {
    Serial.println("❌ routing: 'emails' no es array");
    return false;
  }

  setRecipientsFromArray(doc["emails"].as<JsonArray>());
  return (gRecipientCount > 0);
}

// ===== [MOD - MAIL] Envío a múltiple destinatario (o fallback) =====
bool sendAlertEmail(const String& subject, const String& body) {
  // Refrescar destinatarios si corresponde (timeout 4s)
  // Si falla, se usa fallback.
  fetchRoutingRecipients(false);

  // Debug: mostrar si está enviando por routing o fallback
  if (gRecipientCount > 0) {
    Serial.println("📧 Envío MAIL usando ROUTING (Google Sheet).");
  } else {
    Serial.println("📧 Envío MAIL usando FALLBACK (hardcoded Centro de Control).");
  }

  if (!smtp.connected()) {
    if (!smtp.connect(&mailConfig)) {
      Serial.printf("SMTP connect error. Status=%d, Code=%d, Reason=%s\n",
        smtp.statusCode(), smtp.errorCode(), smtp.errorReason().c_str());
      return false;
    }
  }

  SMTP_Message msg;
  msg.sender.name  = F("ESP32 Alarmas");
  msg.sender.email = AUTHOR_EMAIL;
  msg.subject      = subject.c_str();

  // Si hay routing, enviar a todos. Si no, fallback.
  if (gRecipientCount > 0) {
    for (int i = 0; i < gRecipientCount; i++) {
      msg.addRecipient(F("Tesis"), gRecipients[i].c_str());
    }
  } else {
    msg.addRecipient(F("Tesis"), RECIPIENT_EMAIL);
  }

  msg.text.content = body.c_str();
  msg.text.charSet = "utf-8";
  msg.text.transfer_encoding = Content_Transfer_Encoding::enc_7bit;

  msg.priority = esp_mail_smtp_priority::esp_mail_smtp_priority_normal;
  msg.response.notify = esp_mail_smtp_notify_success | esp_mail_smtp_notify_failure;

  bool ok = MailClient.sendMail(&smtp, &msg);
  if (!ok) {
    Serial.printf("sendMail ERROR. Status=%d, Code=%d, Reason=%s\n",
      smtp.statusCode(), smtp.errorCode(), smtp.errorReason().c_str());
  }
  return ok;
}

// =====================================================
// ===== STORE-AND-FORWARD (RAM + LittleFS) =====
// =====================================================

static const char* LOG_FILE = "/tb_offline.jsonl";
static const char* TMP_FILE = "/tb_offline.tmp";

// Límite de backlog en flash (para no crecer infinito)
static const size_t MAX_LOG_BYTES = 120 * 1024; // 120 KB (ajustable)

// ===== Buffer RAM (100 registros) =====
#define RAM_BUF_MAX 100

TelemetryRec ramBuf[RAM_BUF_MAX];
uint16_t ramHead = 0, ramTail = 0, ramCount = 0;

bool ramPush(const TelemetryRec& r) {
  if (ramCount >= RAM_BUF_MAX) return false;
  ramBuf[ramHead] = r;
  ramHead = (ramHead + 1) % RAM_BUF_MAX;
  ramCount++;
  return true;
}
bool ramPop(TelemetryRec& r) {
  if (ramCount == 0) return false;
  r = ramBuf[ramTail];
  ramTail = (ramTail + 1) % RAM_BUF_MAX;
  ramCount--;
  return true;
}

uint16_t makeDiMask() {
  uint16_t m = 0;
  for (int i = 0; i < 12; i++) if (diStates[i]) m |= (1u << i);
  return m;
}

bool timeIsValid() {
  time_t now = time(nullptr);
  return (now > 1672531200); // post 2023
}

uint64_t getEpochMsNow() {
  struct timeval tv;
  gettimeofday(&tv, nullptr);
  return (uint64_t)tv.tv_sec * 1000ULL + (uint64_t)(tv.tv_usec / 1000ULL);
}

// Función para sincronizar tiempo periódicamente
void checkAndSyncTime() {
  static uint32_t lastTimeCheck = 0;
  if (millis() - lastTimeCheck > 3600000) { // Cada hora
    lastTimeCheck = millis();
    if (WiFi.status() == WL_CONNECTED && !timeIsValid()) {
      configTime(-3 * 3600, 0, "pool.ntp.org", "time.nist.gov");
      Serial.println("🕒 Sincronizando tiempo NTP...");
      // Esperar un poco para sincronización
      for (int i = 0; i < 10 && !timeIsValid(); i++) {
        delay(500);
      }
    }
  }
}

TelemetryRec makeRecFromCurrent(uint64_t custom_ts_ms = 0) {
  TelemetryRec r;

  // Si se proporciona timestamp personalizado, usarlo
  if (custom_ts_ms != 0) {
    r.ts_ms = custom_ts_ms;
    r.ts_valid = true;
  } else {
    r.ts_valid = timeIsValid();
    r.ts_ms = r.ts_valid ? getEpochMsNow() : 0ULL;
  }

  r.mono_ms = millis();
  r.diMask = makeDiMask();
  r.tempC = (int16_t)g_TempC_int;
  r.irmsA = g_Irms_sent_A;
  r.funciona = funciona_flag;
  return r;
}

// Función helper para crear y encolar eventos
void enqueueEventWithCurrentTimestamp() {
  uint64_t eventTs = getEpochMsNow();
  TelemetryRec rec = makeRecFromCurrent(eventTs);

  if (mqttClient.connected()) {
    if (publishRecTB(rec)) {
      // Éxito - actualizar estados enviados
      lastSent_Irms_A = g_Irms_A;
      lastSent_TempC_int = g_TempC_int;
      memcpy(lastDiStates, diStates, sizeof(diStates));
      return;
    }
  }

  // Falló, guardar en buffer
  Serial.println("📦 Sin conectividad / publish falló -> guardando (RAM/FS)");
  enqueueOffline(rec);
}

// Publicación con timestamp para ThingsBoard:
// {"ts":..., "values":{...}}
bool publishRecTB(const TelemetryRec& r) {
  DynamicJsonDocument doc(1024);

  if (r.ts_valid) {
    doc["ts"] = (uint64_t)r.ts_ms;
  }

  JsonObject values = doc.createNestedObject("values");
  values["ts_valid"]  = r.ts_valid;
  values["mono_ms"]   = (uint32_t)r.mono_ms;
  values["SITE_NAME"] = SITE_NAME;
  values["DEVICE_ID"] = DEVICE_ID;

  for (int i = 0; i < 12; i++) {
    String key = "DI" + String(i);
    values[key] = ((r.diMask >> i) & 1);
  }

  values["TempC"]    = r.tempC;
  values["Irms_A"]   = r.irmsA;
  values["Funciona"] = r.funciona;

  char payload[1024];
  size_t n = serializeJson(doc, payload, sizeof(payload));

  Serial.print("Payload size = ");
  Serial.println(n);
  Serial.print("MQTT connected = ");
  Serial.println(mqttClient.connected() ? "YES" : "NO");
  Serial.print("Payload = ");
  Serial.println(payload);

  bool ok = mqttClient.publish("v1/devices/me/telemetry", payload, n);

  if (ok) {
    Serial.print("📤 TB OK (hist): ");
    Serial.print("ts=");
    Serial.print(r.ts_ms);
    Serial.print(", SITE_NAME=");
    Serial.print(SITE_NAME);
    Serial.print(", DEVICE_ID=");
    Serial.print(DEVICE_ID);
    Serial.print(", Temp=");
    Serial.print(r.tempC);
    Serial.print(", I=");
    Serial.print(r.irmsA);
    Serial.print(", Funciona=");
    Serial.println(r.funciona);
  } else {
    Serial.println("❌ publishRecTB falló");
    Serial.print("mqttClient.state() = ");
    Serial.println(mqttClient.state());
  }

  return ok;
}

bool appendRecToFS(const TelemetryRec& r) {
  if (!LittleFS.begin(true)) {
    Serial.println("❌ LittleFS no disponible (append falló)");
    return false;
  }

  // Control de tamaño
  File fsize = LittleFS.open(LOG_FILE, "r");
  if (fsize) {
    size_t sz = fsize.size();
    fsize.close();
    if (sz > MAX_LOG_BYTES) {
      Serial.println("⚠ LOG excede MAX_LOG_BYTES -> se reinicia (pierde lo más viejo)");
      LittleFS.remove(LOG_FILE);
    }
  }

  File f = LittleFS.open(LOG_FILE, "a");
  if (!f) {
    Serial.println("❌ No pude abrir LOG_FILE para append");
    return false;
  }

  // JSON compacto por línea
  StaticJsonDocument<256> doc;
  doc["ts"] = (uint64_t)r.ts_ms;
  doc["mv"] = r.ts_valid;   // "mv" = valid
  doc["mm"] = r.mono_ms;    // "mm" = mono millis

  doc["di"] = r.diMask;
  doc["t"]  = r.tempC;
  doc["i"]  = r.irmsA;
  doc["f"]  = r.funciona;

  if (serializeJson(doc, f) == 0) {
    f.close();
    Serial.println("❌ serializeJson->FS falló");
    return false;
  }
  f.print("\n");
  f.close();

  Serial.print("💾 Guardado en FS: ts=");
  Serial.println(r.ts_ms);
  return true;
}

bool parseLineToRec(const String& line, TelemetryRec& r) {
  StaticJsonDocument<256> doc;
  DeserializationError err = deserializeJson(doc, line);
  if (err) {
    Serial.print("❌ Error parse JSON: ");
    Serial.println(err.c_str());
    return false;
  }

  r.ts_ms    = doc["ts"] | 0ULL;
  r.ts_valid = doc["mv"] | false;
  r.mono_ms  = doc["mm"] | 0u;

  r.diMask   = doc["di"] | 0u;
  r.tempC    = (int16_t)(doc["t"] | 0);
  r.irmsA    = doc["i"] | 0.0f;
  r.funciona = doc["f"] | false;

  return true;
}

void enqueueOffline(const TelemetryRec& r) {
  // Primero RAM; si está lleno -> flash
  if (!ramPush(r)) {
    if (appendRecToFS(r)) {
      Serial.println("✅ Registro guardado en LittleFS");
    }
  } else {
    Serial.print("📝 Registro en RAM buffer: ts=");
    Serial.println(r.ts_ms);
  }
}

void flushRAM(uint16_t maxPerLoop = 10) {
  if (!mqttClient.connected()) {
    Serial.println("⚠ flushRAM: MQTT no conectado");
    return;
  }

  TelemetryRec r;
  uint16_t sent = 0;
  while (sent < maxPerLoop && ramPop(r)) {
    Serial.print("🔄 Enviando desde RAM: ts=");
    Serial.println(r.ts_ms);

    if (!publishRecTB(r)) {
      // si falla, re-encolamos
      Serial.println("❌ Falló envio desde RAM, re-encolando...");
      if (!ramPush(r)) appendRecToFS(r);
      break;
    }
    sent++;
    mqttClient.loop();
    delay(5);
  }

  if (sent > 0) {
    Serial.printf("✅ flushRAM: enviados %u registros\n", sent);
  }
}

void flushFS(uint16_t maxLinesPerLoop = 30) {
  if (!mqttClient.connected()) {
    Serial.println("⚠ flushFS: MQTT no conectado");
    return;
  }

  if (!LittleFS.begin(true)) {
    Serial.println("❌ flushFS: LittleFS no disponible");
    return;
  }

  if (!LittleFS.exists(LOG_FILE)) {
    Serial.println("ℹ️ flushFS: No hay archivo de log");
    return;
  }

  File in = LittleFS.open(LOG_FILE, "r");
  if (!in) {
    Serial.println("❌ flushFS: No pude abrir LOG_FILE para lectura");
    return;
  }

  File out = LittleFS.open(TMP_FILE, "w");
  if (!out) {
    in.close();
    Serial.println("❌ flushFS: No pude abrir TMP_FILE para escritura");
    return;
  }

  uint16_t processed = 0;

  while (in.available()) {
    String line = in.readStringUntil('\n');
    line.trim();
    if (line.length() == 0) continue;

    TelemetryRec r;
    if (!parseLineToRec(line, r)) {
      Serial.println("⚠ Línea corrupta en log, descartada");
      continue;
    }

    if (processed >= maxLinesPerLoop) {
      out.println(line); // dejamos para después
      continue;
    }

    Serial.print("🔄 Enviando desde FS: ts=");
    Serial.println(r.ts_ms);

    if (!publishRecTB(r)) {
      // si falla, preservamos esta línea y el resto
      Serial.println("❌ Falló envio desde FS, preservando resto...");
      out.println(line);
      while (in.available()) {
        String rest = in.readStringUntil('\n');
        rest.trim();
        if (rest.length()) out.println(rest);
      }
      break;
    }

    processed++;
    mqttClient.loop();
    delay(5);
  }

  in.close();
  out.close();

  LittleFS.remove(LOG_FILE);
  LittleFS.rename(TMP_FILE, LOG_FILE);

  if (processed > 0) {
    Serial.printf("✅ flushFS: enviadas %u líneas\n", processed);
  }
}

// =====================================================
// ===== Conexión NO BLOQUEANTE WiFi/MQTT =======
// =====================================================

bool ensureWiFi() {
  static uint32_t lastTry = 0;

  if (WiFi.status() == WL_CONNECTED) {
    digitalWrite(PIN_WIFI_LED, HIGH);
    return true;
  }

  digitalWrite(PIN_WIFI_LED, LOW);

  if (mqttClient.connected()) mqttClient.disconnect();

  if (millis() - lastTry < 5000) return false;
  lastTry = millis();

  Serial.println("📡 WiFi caído/no conectado -> reintentando...");
  WiFi.disconnect();
  WiFi.begin(ssid, password);
  return false;
}

bool ensureMQTT() {
  static uint32_t lastTry = 0;

  if (mqttClient.connected()) return true;
  if (WiFi.status() != WL_CONNECTED) return false;

  if (millis() - lastTry < 3000) return false;
  lastTry = millis();

  Serial.print("🔄 MQTT reconnect...");
  bool ok = mqttClient.connect("ESP32Cliente", tb_token, NULL);
  Serial.println(ok ? "✅" : "❌");

  // Si reconectamos, intentar flushear backlog inmediatamente
  if (ok) {
    Serial.println("🔄 Reconexión MQTT exitosa, iniciando flush de backlog...");
  }

  return ok;
}

// ===== Helpers DI =====
bool checkDIChangesOnly() {
  for (int i = 0; i < 12; i++) if (diStates[i] != lastDiStates[i]) return true;
  return false;
}

// ==== LM35 ====
uint32_t read_mV_avg(int pin, int n) {
  uint32_t acc=0;
  for (int i=0;i<n;i++) {
    acc += analogReadMilliVolts(pin);
    if ((i & 0x0F) == 0) mqttClient.loop();
    delayMicroseconds(200);
  }
  return acc/(uint32_t)n;
}
void measureLM35() {
  uint32_t mv = read_mV_avg(PIN_LM35, LM_NUM_SAMPLES);
  ema_mV = (1.0f - LM_EMA_ALPHA) * ema_mV + LM_EMA_ALPHA * (float)mv;
  g_TempC = TEMP_GAIN * (ema_mV / 10.0f) + TEMP_OFFSETC;
  g_TempC_int = (int)roundf(g_TempC);
}

// ==== CT ====
static float medirVrms_AC(uint32_t N, uint32_t sample_delay_us) {
  uint64_t sum = 0;
  for (uint32_t i = 0; i < N; i++) {
    sum += (uint32_t)analogRead(PIN_CT);
    delayMicroseconds(sample_delay_us);
  }
  float mean_counts = (float)sum / (float)N;

  uint64_t sumsq = 0;
  int minv = 4095, maxv = 0;
  for (uint32_t i = 0; i < N; i++) {
    int r = analogRead(PIN_CT);
    int centered = (int)((float)r - mean_counts);
    sumsq += (int64_t)centered * (int64_t)centered;
    if (r < minv) minv = r;
    if (r > maxv) maxv = r;
    delayMicroseconds(sample_delay_us);
  }

  if (minv <= 8 || maxv >= 4087) {
    Serial.println("⚠ CLIP detectado, bloque descartado");
    return NAN;
  }

  return sqrtf((float)sumsq / (float)N) * SCALE;
}

void computeCT() {
  const float  Ts_us_nom = 80.0f;
  const float  Fs_est    = 1e6f / Ts_us_nom;
  uint32_t samples_per_cycle = (uint32_t)(Fs_est * 0.020f + 0.5f);
  if (samples_per_cycle < 200) samples_per_cycle = 200;

  const uint32_t N_base = 5000;
  uint32_t N = (N_base / samples_per_cycle) * samples_per_cycle;
  if (N < samples_per_cycle * 10) N = samples_per_cycle * 10;
  const uint32_t du = (uint32_t)Ts_us_nom;

  float Vrms_AC = medirVrms_AC(N, du);
  if (isnan(Vrms_AC)) return;

  float Vrms_corr = (Vrms_AC > VRMS0_FIXED)
                  ? sqrtf(Vrms_AC*Vrms_AC - VRMS0_FIXED*VRMS0_FIXED)
                  : 0.0f;

  if (Vrms_corr < DEADBAND_MIN_V) Vrms_corr = 0.0f;

  if (last_block_Vrms_corr > 0.0f) {
    float drop = (last_block_Vrms_corr - Vrms_corr) / (last_block_Vrms_corr + 1e-9f);
    if (drop > DROP_RESET) ema_Vrms_corr = Vrms_corr;
  }

  ema_Vrms_corr = (1.0f - EMA_ALPHA_CT) * ema_Vrms_corr + EMA_ALPHA_CT * Vrms_corr;
  last_block_Vrms_corr = Vrms_corr;

  g_Irms_A = ema_Vrms_corr * AMPS_PER_V * K_GAIN;

  funciona_flag  = (g_Irms_A > ZERO_EPS_A);
  g_Irms_sent_A  = funciona_flag ? g_Irms_A : 0.0f;

  static unsigned long dbg_t = 0;
  if (millis() - dbg_t > 2000) {
    dbg_t = millis();
    Serial.print("Vrms_corr=");  Serial.print(ema_Vrms_corr, 5);
    Serial.print(" V  | Irms="); Serial.print(g_Irms_A, 2);
    Serial.print(" A  | Funciona="); Serial.println(funciona_flag ? "ON":"off");
  }
}

// =====================================================

void setup() {
  Serial.begin(115200);
  delay(200);
// Al conectarnos asumismos que no hay internet, entonces prendemos LED ROJO
  pinMode(PIN_NET_ALERT_LED, OUTPUT);
  digitalWrite(PIN_NET_ALERT_LED, HIGH);

  // ===== LED WiFi =====
  pinMode(PIN_WIFI_LED, OUTPUT);
  digitalWrite(PIN_WIFI_LED, LOW);

  analogReadResolution(12);
  analogSetPinAttenuation(PIN_LM35, ADC_0db);
  analogSetPinAttenuation(PIN_CT,   ADC_11db);

  // WiFi
  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi");
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000) {
    delay(500); Serial.print(".");
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    digitalWrite(PIN_WIFI_LED, HIGH);
    Serial.println("✅ WiFi conectado");
    // ===== [PEDIDO #2] Imprimir IP =====
    Serial.print("IP: "); Serial.println(WiFi.localIP());
  } else {
    digitalWrite(PIN_WIFI_LED, LOW);
    Serial.println("⚠ WiFi no conectado aún (seguimos con reintentos en loop)");
  }

  // MQTT
  mqttClient.setServer(tb_server, tb_port);
  mqttClient.setBufferSize(1024);
  // Modbus
  if (!mb.connect(moxaIP)) {
    Serial.println("❌ Falló conexión Modbus (se reintenta en loop)");
  }

  memset(lastDiStates, 0, sizeof(lastDiStates));
  lastHourlySend = millis();

  // Inicial EMA LM35
  ema_mV = (float)analogReadMilliVolts(PIN_LM35);
  g_TempC_int = (int)roundf(TEMP_GAIN * (ema_mV / 10.0f) + TEMP_OFFSETC);

  lastSent_Irms_A    = NAN;
  lastSent_TempC_int = INT_MIN;

  Serial.print("CT params -> VRMS0_FIXED="); Serial.print(VRMS0_FIXED, 3);
  Serial.print(" V, ZERO_EPS_A="); Serial.print(ZERO_EPS_A, 2);
  Serial.print(" A, K_GAIN="); Serial.println(K_GAIN, 2);

  // EMAIL
  MailClient.networkReconnect(true);
  smtp.debug(1);
  smtp.callback(smtpCallback);

  mailConfig.server.host_name = SMTP_HOST;
  mailConfig.server.port      = SMTP_PORT;
  mailConfig.login.email      = AUTHOR_EMAIL;
  mailConfig.login.password   = AUTHOR_PASSWORD;
  mailConfig.login.user_domain = "";

  // NTP (Mail client lo usa, pero igual configuramos el sistema para time(nullptr))
  mailConfig.time.ntp_server       = F("pool.ntp.org,time.nist.gov");
  mailConfig.time.gmt_offset       = -3;
  mailConfig.time.day_light_offset = 0;

  // ===== NTP del sistema (para timestamps del buffer) =====
  configTime(-3 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  Serial.println("🕒 Configurado NTP, esperando sincronización...");

  // Esperar un poco por sincronización inicial
  for (int i = 0; i < 20; i++) {
    if (timeIsValid()) {
      Serial.println("✅ Tiempo sincronizado");
      break;
    }
    delay(250);
  }

  // ===== LittleFS =====
  if (!LittleFS.begin(true)) {
    Serial.println("❌ LittleFS init falló (se seguirá con RAM buffer)");
  } else {
    Serial.println("✅ LittleFS listo");
  }

  // Inicializar estados previos para bordes
  if (!mb.readDiscreteInputs(0, diStates, 12)) {
    memset(diStates, 0, sizeof(diStates));
  }
  memcpy(lastDiStates, diStates, sizeof(diStates));
  lastDoorState = diStates[DOOR_DI_INDEX];

  lastNowIsZero = (g_Irms_A <= ZERO_EPS_A);

  // ===== [MAIL] Primer fetch (si hay WiFi) =====
  if (WiFi.status() == WL_CONNECTED) {
    fetchRoutingRecipients(true);
  }

  // Primer intento MQTT (no bloqueante)
  ensureMQTT();
}

void loop() {
  
  
  static uint32_t lastInetCheckMs = 0;
static bool internetOK = false;

if (millis() - lastInetCheckMs > 15000) { // cada 15 segundos
  lastInetCheckMs = millis();
  internetOK = hasInternet_();

  // LED: ON = falla, OFF = OK
 digitalWrite(PIN_NET_ALERT_LED, internetOK ?  LOW : HIGH);

}


  
  
  
  
  // ===== Verificar y sincronizar tiempo =====
  checkAndSyncTime();

  // ===== Conexión no bloqueante + LED =====
  ensureWiFi();
  ensureMQTT();
  mqttClient.loop();

  // 1) DI por Modbus
  if (!mb.readDiscreteInputs(0, diStates, 12)) {
    Serial.println("❌ Modbus read falló, reconectando...");
    mb.disconnect(); delay(200); mb.connect(moxaIP);
  }

  // 2) Medidas
  measureLM35();
  computeCT();

  // 3) Lógica de envío / encolado
  unsigned long now = millis();
  bool timeForHourly = (now - lastHourlySend >= hourlyInterval);
  bool diChanged = checkDIChangesOnly();

  bool tempBigChange = false;
  if (lastSent_TempC_int == INT_MIN || abs(g_TempC_int - lastSent_TempC_int) >= 5)
    tempBigChange = true;

  bool currentBigChange = false;
  if (isnan(lastSent_Irms_A) || fabsf(g_Irms_A - lastSent_Irms_A) >= SEND_DELTA_IRMS_A)
    currentBigChange = true;

  bool nowIsZero = (g_Irms_A <= ZERO_EPS_A);
  bool currentZeroEdge = (lastNowIsZero != nowIsZero);

  // Detectar eventos importantes
  bool eventOccurred = diChanged || tempBigChange || currentBigChange || currentZeroEdge || timeForHourly;

  if (eventOccurred) {
    // CAPTURAR TIMESTAMP INMEDIATAMENTE cuando ocurre un evento
    uint64_t eventTimestamp = getEpochMsNow();

    // Log del tipo de evento
    if (timeForHourly) {
      lastHourlySend = now;
      Serial.println("⏰ Keepalive 1h");
    }
    if (diChanged)          Serial.println("🔄 Cambio de estado (DI)");
    if (tempBigChange)      Serial.println("📈 ΔTemp ≥ 5 °C");
    if (currentBigChange)   Serial.println("⚡ ΔI ≥ 5 A (corriente real)");
    if (currentZeroEdge)    Serial.println(nowIsZero ? "🛑 I→0 A (Funciona=FALSE)"
                                                     : "▶ I>0 A (Funciona=TRUE)");

    // Crear registro con timestamp del evento
    TelemetryRec rec = makeRecFromCurrent(eventTimestamp);

    // Intentar enviar
    bool sent = false;
    if (mqttClient.connected()) {
      sent = publishRecTB(rec);
    }

    if (!sent) {
      Serial.println("📦 Sin conectividad / publish falló -> guardando (RAM/FS)");
      enqueueOffline(rec);
    } else {
      // Actualizar "últimos enviados" solo si publish OK
      lastSent_Irms_A    = g_Irms_A;
      lastSent_TempC_int = g_TempC_int;
      memcpy(lastDiStates, diStates, sizeof(diStates));
    }
  }

  // ===== Flush de backlog cuando vuelve MQTT =====
  if (mqttClient.connected()) {
    flushRAM(10);
    flushFS(30);
  }

  // ===== EMAIL ALERTS =====

  // 1) Corriente pasa a 0 o se restablece
  if (currentZeroEdge) {
    // Capturar timestamp del evento de alarma
    uint64_t alarmTimestamp = getEpochMsNow();
    TelemetryRec alarmRec = makeRecFromCurrent(alarmTimestamp);

    // Intentar enviar inmediatamente
    bool sent = mqttClient.connected() ? publishRecTB(alarmRec) : false;
    if (!sent) {
      enqueueOffline(alarmRec);
    }

    // Enviar email
    if (nowIsZero) {
      String subj = "[ALERTA] " + String(SITE_NAME) + ": Corriente en 0 A";
      String body = "Sitio: " + String(SITE_NAME) + "\n"
                    "Se detectó Irms <= " + String(ZERO_EPS_A, 2) + " A (Funciona=FALSE).\n"
                    "Lectura actual: " + String(g_Irms_A, 2) + " A\n"
                    "Timestamp: " + String(alarmTimestamp) + " ms";
      sendAlertEmail(subj, body);
    } else {
      String subj = "[RECUPERACIÓN] " + String(SITE_NAME) + ": Corriente restablecida";
      String body = "Sitio: " + String(SITE_NAME) + "\n"
                    "Irms > " + String(ZERO_EPS_A, 2) + " A (Funciona=TRUE).\n"
                    "Lectura actual: " + String(g_Irms_A, 2) + " A\n"
                    "Timestamp: " + String(alarmTimestamp) + " ms";
      sendAlertEmail(subj, body);
    }
    lastNowIsZero = nowIsZero;
  }

  // 2) Temperatura alta / normaliza
  if (!tempAlertActive && g_TempC_int > TEMP_ALERT_HIGH) {
    tempAlertActive = true;

    // Capturar timestamp y guardar evento
    uint64_t alarmTimestamp = getEpochMsNow();
    TelemetryRec alarmRec = makeRecFromCurrent(alarmTimestamp);

    bool sent = mqttClient.connected() ? publishRecTB(alarmRec) : false;
    if (!sent) {
      enqueueOffline(alarmRec);
    }

    String subj = "[ALERTA] " + String(SITE_NAME) + ": Temperatura alta (" + String(g_TempC_int) + " °C)";
    String body = "Sitio: " + String(SITE_NAME) + "\n"
                  "La temperatura superó " + String(TEMP_ALERT_HIGH) + " °C.\n"
                  "Temp actual: " + String(g_TempC_int) + " °C\n"
                  "Timestamp: " + String(alarmTimestamp) + " ms";
    sendAlertEmail(subj, body);
  } else if (tempAlertActive && g_TempC_int < TEMP_ALERT_RESET) {
    tempAlertActive = false;

    // Capturar timestamp y guardar evento
    uint64_t alarmTimestamp = getEpochMsNow();
    TelemetryRec alarmRec = makeRecFromCurrent(alarmTimestamp);

    bool sent = mqttClient.connected() ? publishRecTB(alarmRec) : false;
    if (!sent) {
      enqueueOffline(alarmRec);
    }

    String subj = "[RECUPERACIÓN] " + String(SITE_NAME) + ": Temperatura normalizada (" + String(g_TempC_int) + " °C)";
    String body = "Sitio: " + String(SITE_NAME) + "\n"
                  "La temperatura descendió por debajo de " + String(TEMP_ALERT_RESET) + " °C.\n"
                  "Temp actual: " + String(g_TempC_int) + " °C\n"
                  "Timestamp: " + String(alarmTimestamp) + " ms";
    sendAlertEmail(subj, body);
  }

  // 3) Puerta
  bool doorState = diStates[DOOR_DI_INDEX];
  if (doorState != lastDoorState) {
    // Capturar timestamp y guardar evento
    uint64_t alarmTimestamp = getEpochMsNow();
    TelemetryRec alarmRec = makeRecFromCurrent(alarmTimestamp);

    bool sent = mqttClient.connected() ? publishRecTB(alarmRec) : false;
    if (!sent) {
      enqueueOffline(alarmRec);
    }

    if (doorState) {
      String subj = "[ALERTA] " + String(SITE_NAME) + ": Puerta ABIERTA (DI" + String(DOOR_DI_INDEX) + ")";
      String body = "Sitio: " + String(SITE_NAME) + "\n"
                    "Se detectó apertura de puerta en DI" + String(DOOR_DI_INDEX) + ".\n"
                    "Timestamp: " + String(alarmTimestamp) + " ms";
      sendAlertEmail(subj, body);
    } else {
      String subj = "[INFO] " + String(SITE_NAME) + ": Puerta CERRADA (DI" + String(DOOR_DI_INDEX) + ")";
      String body = "Sitio: " + String(SITE_NAME) + "\n"
                    "Se detectó cierre de puerta en DI" + String(DOOR_DI_INDEX) + ".\n"
                    "Timestamp: " + String(alarmTimestamp) + " ms";
      sendAlertEmail(subj, body);
    }
    lastDoorState = doorState;
  }

  delay(50);
  
}
